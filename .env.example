# Copy this file to .env and fill in your values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Windows cmd:         copy .env.example .env

# OpenAI-compatible endpoint (OpenAI, DeepSeek, Groq, Ollama, etc.)
LLM_API_KEY=
LLM_BASE_URL=          # optional: override endpoint, e.g. https://api.deepseek.com/v1
LLM_MODEL=             # optional: model name; falls back to gpt-4o-mini if unset

# Anthropic (only used if LLM_BASE_URL points at an Anthropic endpoint)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20240620

# Which model provider to use (claude uses Anthropic; openai uses LLM_API_KEY)
RAG_PROVIDER=openai